      "term": {
        "en": "crest"
      },
      "explain": {
        "en": "Long feathers on the head that stand up or hang down."
      }
    },
    {
      "term": {
        "en": "eye stripe"
      },
      "explain": {
        "en": "A stripe through or behind the eye."
      }
    },
    {
      "term": {
        "en": "rump"
      },
      "explain": {
        "en": "The area between the back and the tail."
      }
    }
  ],
