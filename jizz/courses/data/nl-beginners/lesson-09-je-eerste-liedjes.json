        "nl": "zang"
      },
      "explain": {
        "nl": "Het liedje van een vogel, vooral in het voorjaar. Meestal zingt het mannetje, om een plek te claimen en een vrouwtje te lokken."
      }
    },
    {
      "term": {
        "nl": "roep"
      },
      "explain": {
        "nl": "Een kort geluidje om contact te houden of te waarschuwen. Vogels roepen het hele jaar."
      }
    },
    {
      "term": {
        "nl": "strofe"
      },
      "explain": {
        "nl": "Eén liedje van begin tot eind, tot de vogel even stopt."
      }
    },
    {
      "term": {
        "nl": "triller"
      },
      "explain": {
        "nl": "Een reeks heel snelle, gelijke tonen, als een rollende r."
      }
    }
